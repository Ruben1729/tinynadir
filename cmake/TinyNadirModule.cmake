include_guard(GLOBAL)
include(CMakeParseArguments)
include(GNUInstallDirs)

# tinynadir_add_module(NAME tinyfoo SOURCES src/tinyfoo.c
#                      [DEPENDS tinybar] [TEST_SOURCES tests/test_tinyfoo.c])
function(_tinynadir_add_module)
    cmake_parse_arguments(M "" "NAME" "SOURCES;DEPENDS;TEST_SOURCES" ${ARGN})
    if(NOT M_NAME OR NOT M_SOURCES)
        message(FATAL_ERROR "tinynadir_add_module requires NAME and SOURCES")
    endif()
    if(NOT DEFINED TINYNADIR_INSTALL)
        set(TINYNADIR_INSTALL ${PROJECT_IS_TOP_LEVEL})
    endif()
    foreach(dep IN LISTS M_DEPENDS)
        if(NOT TARGET ${dep}::${dep})
            if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/../${dep}/CMakeLists.txt")
                message(FATAL_ERROR "${M_NAME} requires the ${dep} module")
            endif()
            if(dep STREQUAL "tinysgp4")
                # The original standalone module uses its historic TGP4 options.
                set(TGP4_INSTALL ${TINYNADIR_INSTALL})
                set(TGP4_BUILD_TESTS OFF)
                set(TGP4_BUILD_EXAMPLES OFF)
            endif()
            add_subdirectory("${CMAKE_CURRENT_SOURCE_DIR}/../${dep}"
                "${CMAKE_CURRENT_BINARY_DIR}/dependencies/${dep}")
        endif()
    endforeach()
    set(_native_default OFF)
    if(PROJECT_IS_TOP_LEVEL AND NOT CMAKE_CROSSCOMPILING)
        set(_native_default ON)
    endif()
    if(DEFINED TINYNADIR_BUILD_TESTS)
        set(_test_default ${TINYNADIR_BUILD_TESTS})
    else()
        set(_test_default ${_native_default})
    endif()
    if(DEFINED TINYNADIR_INSTALL)
        set(_install_default ${TINYNADIR_INSTALL})
    else()
        set(_install_default ${PROJECT_IS_TOP_LEVEL})
    endif()
    string(TOUPPER "${M_NAME}" _upper)
    option(${_upper}_BUILD_TESTS "Build ${M_NAME} static regression tests" ${_test_default})
    option(${_upper}_INSTALL "Install ${M_NAME}" ${_install_default})
    add_library(${M_NAME} STATIC ${M_SOURCES})
    target_sources(${M_NAME} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/CheckBinary64.c")
    add_library(${M_NAME}::${M_NAME} ALIAS ${M_NAME})
    set_target_properties(${M_NAME} PROPERTIES C_STANDARD 99 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    target_include_directories(${M_NAME} PUBLIC
        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
        $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>)
    if(NOT MSVC)
        target_link_libraries(${M_NAME} PUBLIC m)
        target_compile_options(${M_NAME} PRIVATE -Wall -Wextra -Wpedantic)
    endif()
    foreach(dep IN LISTS M_DEPENDS)
        target_link_libraries(${M_NAME} PUBLIC ${dep}::${dep})
    endforeach()
    if(TINYNADIR_ENABLE_SANITIZERS)
        if(CMAKE_CROSSCOMPILING OR NOT CMAKE_C_COMPILER_ID MATCHES "^(GNU|Clang|AppleClang)$")
            message(FATAL_ERROR "Sanitizers require a native GCC/Clang build")
        endif()
        target_compile_options(${M_NAME} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
        target_link_options(${M_NAME} INTERFACE -fsanitize=address,undefined)
    endif()
    if(${_upper}_BUILD_TESTS AND M_TEST_SOURCES)
        set(_tinynadir_module_tests_enabled TRUE PARENT_SCOPE)
        enable_testing()
        add_executable(${M_NAME}_test ${M_TEST_SOURCES})
        set_target_properties(${M_NAME}_test PROPERTIES C_STANDARD 99 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        target_link_libraries(${M_NAME}_test PRIVATE ${M_NAME}::${M_NAME})
        if(NOT MSVC)
            target_compile_options(${M_NAME}_test PRIVATE -Wall -Wextra -Wpedantic)
        endif()
        if(TINYNADIR_ENABLE_SANITIZERS)
            target_compile_options(${M_NAME}_test PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
        endif()
        add_test(NAME ${M_NAME}.regression COMMAND ${M_NAME}_test)
        set_tests_properties(${M_NAME}.regression PROPERTIES WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}")
        if(CMAKE_NM AND NOT MSVC)
            add_test(NAME ${M_NAME}.no_heap COMMAND "${CMAKE_COMMAND}"
                "-DNM=${CMAKE_NM}" "-DARCHIVE=$<TARGET_FILE:${M_NAME}>"
                -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tinysgp4/cmake/CheckNoHeap.cmake")
        endif()
    else()
        set(_tinynadir_module_tests_enabled FALSE PARENT_SCOPE)
    endif()
    if(${_upper}_INSTALL)
        include(CMakePackageConfigHelpers)
        set(_dir "${CMAKE_INSTALL_LIBDIR}/cmake/${M_NAME}")
        install(TARGETS ${M_NAME} EXPORT ${M_NAME}Targets ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}")
        install(DIRECTORY include/ DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}")
        install(EXPORT ${M_NAME}Targets NAMESPACE ${M_NAME}:: DESTINATION "${_dir}")
        set(_dependencies "")
        foreach(dep IN LISTS M_DEPENDS)
            string(APPEND _dependencies "find_dependency(${dep} CONFIG)
")
        endforeach()
        set(_template [=[include(CMakeFindDependencyMacro)
@_dependencies@
include("${CMAKE_CURRENT_LIST_DIR}/@M_NAME@Targets.cmake")
]=])
        string(CONFIGURE "${_template}" _config @ONLY)
        file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/${M_NAME}Config.cmake" "${_config}")
        write_basic_package_version_file("${CMAKE_CURRENT_BINARY_DIR}/${M_NAME}ConfigVersion.cmake"
            VERSION 0.1.0 COMPATIBILITY SameMajorVersion)
        install(FILES "${CMAKE_CURRENT_BINARY_DIR}/${M_NAME}Config.cmake"
            "${CMAKE_CURRENT_BINARY_DIR}/${M_NAME}ConfigVersion.cmake" DESTINATION "${_dir}")
        if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/README.md")
            install(FILES README.md DESTINATION "${CMAKE_INSTALL_DATADIR}/doc/${M_NAME}")
        endif()
        foreach(_notice LICENSE NOTICE)
            if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/${_notice}")
                install(FILES "${_notice}" DESTINATION "${CMAKE_INSTALL_DATADIR}/doc/${M_NAME}")
            endif()
        endforeach()
    endif()
endfunction()

# enable_testing's directory variable must outlive the implementation function.
macro(tinynadir_add_module)
    _tinynadir_add_module(${ARGV})
    if(_tinynadir_module_tests_enabled)
        enable_testing()
    endif()
endmacro()
